// flinkli — Prisma şeması
// Veritabanı: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Kullanıcı ve Abonelik
// ============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  locale       String   @default("de-CH")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  companies    Company[]
  subscription Subscription?

  @@map("users")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  plan                 String    @default("free")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  status               String    @default("active")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================
// Şirket (fatura kesen taraf)
// ============================================

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String
  addressLine1    String   @map("address_line1")
  addressLine2    String?  @map("address_line2")
  postalCode      String   @map("postal_code")
  city            String
  country         String   @default("CH")
  vatNumber       String?  @map("vat_number")
  iban            String
  logoUrl         String?  @map("logo_url")
  defaultCurrency String   @default("CHF") @map("default_currency")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers        Customer[]
  invoices         Invoice[]
  projects         Project[]
  recurringInvoices RecurringInvoice[]
  quotes           Quote[]
  expenses         Expense[]
  integrations     AccountingIntegration[]

  @@index([userId])
  @@map("companies")
}

// ============================================
// Müşteri
// ============================================

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  email        String?
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  postalCode   String   @map("postal_code")
  city         String
  country      String   @default("CH")
  vatNumber    String?  @map("vat_number")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  projects          Project[]
  recurringInvoices RecurringInvoice[]
  quotes            Quote[]
  portalAccess      CustomerPortal[]

  @@index([companyId])
  @@map("customers")
}

// ============================================
// Fatura
// ============================================

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  invoiceNumber   String    @map("invoice_number")
  issueDate       DateTime  @map("issue_date")
  dueDate         DateTime  @map("due_date")
  subtotal        Decimal   @db.Decimal(12, 2)
  vatAmount       Decimal   @map("vat_amount") @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  currency        String    @default("CHF")
  status          String    @default("draft")
  qrReference     String?   @map("qr_reference")
  qrReferenceType String    @default("NON") @map("qr_reference_type")
  pdfUrl          String?   @map("pdf_url")
  notes           String?
  sentAt          DateTime? @map("sent_at")
  paidAt          DateTime? @map("paid_at")
  reminderCount   Int       @default(0) @map("reminder_count")
  lastReminderAt  DateTime? @map("last_reminder_at")
  /// TWINT ödeme linki (müşteriye gösterilir)
  twintPaymentLink String?  @map("twint_payment_link")
  /// TWINT ödeme durumu: none | pending | paid
  twintStatus      String   @default("none") @map("twint_status")
  /// TWINT ile ödendiği zaman
  twintPaidAt      DateTime? @map("twint_paid_at")
  /// Müşteri e-imzası (data URL, PNG)
  signatureData   String?   @map("signature_data")
  /// İmzalayan kişinin adı
  signedByName    String?   @map("signed_by_name")
  /// İmza zamanı
  signedAt        DateTime? @map("signed_at")
  /// İmza IP adresi (denetim izi)
  signedIp        String?   @map("signed_ip")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  vatRate     Decimal @map("vat_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================
// Proje
// ============================================

model Project {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String
  status     String   @default("active")
  hourlyRate Decimal? @map("hourly_rate") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([companyId])
  @@index([customerId])
  @@map("projects")
}

// ============================================
// Tekrarlayan Fatura (Recurring Invoice)
// ============================================

model RecurringInvoice {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  name            String
  /// daily | weekly | monthly | quarterly | yearly
  frequency       String    @default("monthly")
  /// Kaç periyotta bir (örn. 2 = iki ayda bir)
  intervalCount   Int       @default(1) @map("interval_count")
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  nextRunAt       DateTime  @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  /// Fatura vadesi (gün)
  dueDays         Int       @default(30) @map("due_days")
  currency        String    @default("CHF")
  qrReferenceType String    @default("NON") @map("qr_reference_type")
  notes           String?
  /// active | paused | completed
  status          String    @default("active")
  /// Otomatik e-posta gönderilsin mi
  autoSend        Boolean   @default(false) @map("auto_send")
  /// Kalemler JSON olarak saklanır (şablon)
  items           Json
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([customerId])
  @@index([nextRunAt])
  @@index([status])
  @@map("recurring_invoices")
}

// ============================================
// Teklif (Quote)
// ============================================

model Quote {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  quoteNumber     String    @map("quote_number")
  issueDate       DateTime  @map("issue_date")
  validUntil      DateTime  @map("valid_until")
  subtotal        Decimal   @db.Decimal(12, 2)
  vatAmount       Decimal   @map("vat_amount") @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  currency        String    @default("CHF")
  /// draft | sent | accepted | rejected | expired | converted
  status          String    @default("draft")
  notes           String?
  /// Teklif kabul edilip faturaya dönüştürüldüyse oluşan fatura
  convertedInvoiceId String? @map("converted_invoice_id") @db.Uuid
  sentAt          DateTime? @map("sent_at")
  acceptedAt      DateTime? @map("accepted_at")
  /// Müşteri e-imzası (data URL, PNG)
  signatureData   String?   @map("signature_data")
  /// İmzalayan kişinin adı
  signedByName    String?   @map("signed_by_name")
  /// İmza zamanı
  signedAt        DateTime? @map("signed_at")
  /// İmza IP adresi (denetim izi)
  signedIp        String?   @map("signed_ip")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    QuoteItem[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  vatRate     Decimal @map("vat_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

// ============================================
// Gider (Expense)
// ============================================

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  date        DateTime
  description String
  category    String   @default("other")
  amount      Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @default(0) @map("vat_amount") @db.Decimal(12, 2)
  currency    String   @default("CHF")
  vendor      String?
  /// Gider fişi/faturası referansı
  reference   String?
  /// KDV indirilebilir mi
  deductible  Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
  @@index([category])
  @@map("expenses")
}

// ============================================
// Müşteri Portalı Erişimi (Customer Portal)
// ============================================

model CustomerPortal {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  /// Benzersiz erişim token'ı (URL'de kullanılır)
  token      String    @unique
  /// Portal aktif mi
  active     Boolean   @default(true)
  /// Son erişim tarihi
  lastAccessAt DateTime? @map("last_access_at")
  /// Erişim sayısı
  accessCount  Int     @default(0) @map("access_count")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_portals")
}

// ============================================
// Muhasebe Entegrasyonu (Accounting Integration)
// ============================================

model AccountingIntegration {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  /// Sağlayıcı: bexio | abacus | banana
  provider         String    @default("bexio")
  /// OAuth erişim token'ı (şifreli saklanmalıdır; üretimde KMS kullanın)
  accessToken      String?   @map("access_token")
  /// OAuth yenileme token'ı
  refreshToken     String?   @map("refresh_token")
  /// Erişim token'ının son kullanma zamanı
  expiresAt        DateTime? @map("expires_at")
  /// Sağlayıcı tarafındaki kiracı/şirket kimliği
  externalTenantId String?   @map("external_tenant_id")
  /// Bağlantı durumu: connected | disconnected | error
  status           String    @default("disconnected")
  /// Son başarılı senkronizasyon zamanı
  lastSyncAt       DateTime? @map("last_sync_at")
  /// Son senkronizasyon hatası (varsa)
  syncError        String?   @map("sync_error")
  /// Senkronize edilen fatura sayısı
  syncedInvoices   Int       @default(0) @map("synced_invoices")
  /// Senkronize edilen gider sayısı
  syncedExpenses   Int       @default(0) @map("synced_expenses")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("accounting_integrations")
}
