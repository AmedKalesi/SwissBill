{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @flinkli/shared build",
    "build": "tsc -p tsconfig.json",
    "start": "sh -c 'DIRECT_URL=${DIRECT_URL:-$DATABASE_URL} prisma migrate deploy && node dist/server.js'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo \"no lint yet\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "sh -c 'DIRECT_URL=${DIRECT_URL:-$DATABASE_URL} prisma migrate deploy'",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@prisma/client": "^5.22.0",
    "@flinkli/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "resend": "^4.0.1",
    "stripe": "^17.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
