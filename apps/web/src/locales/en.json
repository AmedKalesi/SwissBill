    "faqTitle": "Frequently asked questions",
    "faqSubtitle": "Everything you need to know before you start.",
    "faq": {
      "qr": {
        "q": "What exactly is a Swiss QR-bill?",
        "a": "A QR-bill is the official Swiss payment slip with a QR code that carries all payment data. flinkli generates fully compliant QR-bills (Swiss Payment Standards 2026) that your customers can scan with any Swiss banking app."
      },
      "swiss": {
        "q": "Is flinkli only for Swiss businesses?",
        "a": "flinkli is built around Swiss invoicing rules — QR-bills, Swiss VAT rates and CHF — so it fits Swiss freelancers and small businesses best. You can still invoice in EUR and other currencies."
      },
      "languages": {
        "q": "Which languages are supported?",
        "a": "The interface and your invoices are available in German, English, French, Italian, Turkish and Kurdish. You can switch language at any time without losing data."
      },
      "data": {
        "q": "Where is my data stored?",
        "a": "Your data is stored on Swiss-hosted infrastructure and encrypted in transit. You stay in control and can export your invoices at any time."
      },
      "cancel": {
        "q": "Can I cancel at any time?",
        "a": "Yes. There is no lock-in and no cancellation fee. You can downgrade to the free plan or cancel whenever you like — your data remains exportable."
      },
      "support": {
        "q": "Do you offer support?",
        "a": "Yes. As an early-stage product, support comes directly from the founder. Write to us and you will get a real answer, usually within one business day."
      }
    }
  },
