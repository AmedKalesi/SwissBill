# ============================================
# SwissBill — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp doldurun:  cp .env.example .env
# Tüm değişkenler apps/api/src/config/env.ts içinde Zod ile doğrulanır.
# ============================================

# --- Veritabanı (PostgreSQL / Supabase) ---
# Supabase panelinden alın: Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"
# Migration'lar için doğrudan (pooler'sız) bağlantı — opsiyonel ama Supabase'de önerilir
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Kimlik Doğrulama ---
# JWT imzalama sırrı — EN AZ 16 KARAKTER (zorunlu)
# Üretmek için: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"

# --- Backend ---
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# --- Stripe (CHF abonelik) — opsiyonel ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_BUSINESS="price_..."

# --- E-posta (Resend) — opsiyonel ---
RESEND_API_KEY="re_..."
EMAIL_FROM="SwissBill <fatura@swissbill.ch>"

# --- TWINT ödeme — opsiyonel ---
# Kimlik bilgileri tanımlı değilse TWINT servisi demo modda çalışır.
TWINT_BASE_URL="https://pay.twint.ch"
TWINT_MERCHANT_ID=""
# Ödeme linklerinde kullanılan genel taban URL (varsayılan: https://swissbill.app)
APP_BASE_URL="http://localhost:4000"

# --- Muhasebe entegrasyonu (Bexio) — opsiyonel ---
# Kimlik bilgileri tanımlı değilse entegrasyon demo modda çalışır.
BEXIO_CLIENT_ID=""
BEXIO_CLIENT_SECRET=""

# --- Zamanlanmış Görevler (Cron) ---
# Harici cron çağrılarını koruyan paylaşılan sır (X-Cron-Secret başlığı).
# En az 16 karakter. Örn: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-secret"
# Sunucu içi zamanlayıcıyı etkinleştir (true/false). Çok instance'lı
# deploy'larda çift çalışmayı önlemek için false yapıp harici cron kullanın.
CRON_ENABLED="true"
# Tekrarlayan fatura kontrolü (cron ifadesi) — varsayılan: her gün 06:00
CRON_RECURRING_SCHEDULE="0 6 * * *"
# Ödeme hatırlatma kontrolü (cron ifadesi) — varsayılan: her gün 07:00
CRON_REMINDER_SCHEDULE="0 7 * * *"
