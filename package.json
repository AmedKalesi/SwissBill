{
  "name": "flinkli",
  "version": "0.1.0",
  "private": true,
  "description": "QR-fatura + müşteri yönetim aracı (İsviçreli freelancer'lar için)",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter @flinkli/shared build && pnpm --filter @flinkli/web build",
    "build:all": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.8.1"
}
